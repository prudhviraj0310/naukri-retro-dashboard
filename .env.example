USERNAME=your_naukri_email_or_mobile
PASSWORD=your_naukri_password
NAUKRI_MOBILE=your_registered_mobile_number

# Optional one-time value for server/manual OTP runs. Prefer passing --otp
# interactively and avoid committing or storing this permanently.
NAUKRI_OTP=

# Prefer the standard OpenAI env var. OPEN_API_KEY is also supported for compatibility
# with the upstream NopeRi script.
OPENAI_API_KEY=your_openai_api_key

# OpenRouter AI Integration — powers resume tailoring, headline optimization,
# and intelligent questionnaire answering.
# Sign up at https://openrouter.ai to get your API key.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Keep this unset unless you intentionally want live applications.
CAREERFLOW_CONFIRM_APPLY=false
